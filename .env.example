APP_NAME=OCR Application
APP_VERSION=0.1.0
DATA_DIR=./data
MAX_UPLOAD_MB=512
LOG_LEVEL=INFO
CORS_ORIGINS=*
ENABLE_TESSERACT=true
TESSERACT_LANGS=eng
